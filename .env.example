# ============================================================================
# ConversionOps — Environment Variable Reference
# Copy this file to .env and fill in all values before running the app.
# NEVER commit .env to git. It is already listed in .gitignore.
# ============================================================================

NODE_ENV=development

# ============================================================================
# CORE APPLICATION
# ============================================================================
APP_NAME=conversionops
APP_VERSION=1.0.0
PORT=3001
LOG_LEVEL=info

API_BASE_URL=https://api.conversionops.in

NEXT_PUBLIC_APP_URL=https://app.conversionops.in
# IMPORTANT: Must include /v1 suffix — the NestJS API uses a global /v1 prefix.
NEXT_PUBLIC_API_URL=https://api.conversionops.in/v1
NEXT_PUBLIC_WS_URL=wss://api.conversionops.in

APP_URL=https://app.conversionops.in

# Include all front-end origins that call the API (app, web, admin).
CORS_ORIGIN=https://app.conversionops.in,https://conversionops.in,https://admin.conversionops.in

# ============================================================================
# DATABASE — PostgreSQL 16
# Local:      postgresql://conversionops:password@localhost:5432/conversionops
# GCP (prod): postgresql://user:pass@/db?host=/cloudsql/project:region:instance
# ============================================================================
DATABASE_URL=postgresql://conversionops:password@localhost:5432/conversionops
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# ============================================================================
# REDIS (Memorystore / local)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_MAX_RETRIES_PER_REQUEST=5

# ============================================================================
# AUTH — JWT & Magic Links
# JWT_SECRET must be >= 64 chars in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================================
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET
JWT_EXPIRY=7d
MAGIC_LINK_SECRET=REPLACE_WITH_MAGIC_LINK_SECRET
MAGIC_LINK_EXPIRY=15m

SESSION_COOKIE_NAME=conversionops.sid
SESSION_COOKIE_DOMAIN=.conversionops.in
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# ============================================================================
# GCP & VERTEX AI
# ============================================================================
GOOGLE_CLOUD_PROJECT=conversionops-prod
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash
AI_RESPONSE_TIMEOUT_MS=15000
AI_MAX_CONVERSATION_DEPTH=25
AI_MAX_DAILY_TOKENS_PER_WORKSPACE=500000
AI_MAX_MONTHLY_COST_USD=500

# ============================================================================
# TWILIO — SMS / VOICE
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_WEBHOOK_URL=https://api.conversionops.in/v1/webhooks/twilio/sms
TWILIO_STATUS_WEBHOOK_URL=https://api.conversionops.in/v1/webhooks/twilio/status
TWILIO_VOICE_WEBHOOK_URL=https://api.conversionops.in/v1/webhooks/twilio/voice
TWILIO_VOICE_STATUS_WEBHOOK_URL=https://api.conversionops.in/v1/webhooks/twilio/voice-status
TWILIO_ENABLE_SMART_ENCODING=true
TWILIO_ENABLE_STICKY_SENDER=true
MAX_SMS_PER_LEAD_PER_DAY=10
MAX_SMS_PER_WORKSPACE_PER_DAY=5000

# ============================================================================
# STRIPE — Billing
# ============================================================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_SOLO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_BROKERAGE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
# Must be production URLs — not localhost
STRIPE_SUCCESS_URL=https://app.conversionops.in/settings/billing
STRIPE_CANCEL_URL=https://app.conversionops.in/settings/billing

# ============================================================================
# RESEND — Email
# ============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@conversionops.in
EMAIL_REPLY_TO=hello@conversionops.in
EMAIL_SUPPORT_ADDRESS=hello@conversionops.in

# ============================================================================
# CAL.COM — Appointment Booking
# ============================================================================
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxx
CALCOM_WEBHOOK_SECRET=your_calcom_webhook_secret
CALCOM_WEBHOOK_BASE_URL=https://api.conversionops.in/v1/webhooks/calcom
NEXT_PUBLIC_CALCOM_LINK=your-username/conversionops-demo

# ============================================================================
# CRM INTEGRATIONS
# ============================================================================
FOLLOW_UP_BOSS_API_KEY=
FOLLOW_UP_BOSS_WEBHOOK_SECRET=
ZAPIER_WEBHOOK_SECRET=
ENABLE_CRM_SYNC=true

# ============================================================================
# ADMIN & SECURITY
# ============================================================================
ADMIN_API_KEY=generate_a_strong_random_64_char_hex_key
# Ops-console (apps/admin) reads this client-side; MUST equal ADMIN_API_KEY.
# Exposed in the admin client bundle — keep the admin app behind VPN / IP allowlist.
NEXT_PUBLIC_ADMIN_API_KEY=generate_a_strong_random_64_char_hex_key
INTERNAL_ADMIN_EMAILS=hello@conversionops.in
OPS_IP_ALLOWLIST=127.0.0.1
ENABLE_HELMET=true
ENABLE_CSRF_PROTECTION=true
REQUEST_SIGNATURE_VALIDATION=true
PASSWORD_HASH_ROUNDS=12

# ============================================================================
# COMPLIANCE — TCPA / Fair Housing / CCPA
# ============================================================================
TCPA_ENFORCEMENT_ENABLED=true
STOP_KEYWORD_ENFORCEMENT=true
REQUIRE_SMS_CONSENT=true
COMPLIANCE_LOGGING_ENABLED=true
FAIR_HOUSING_FILTER_ENABLED=true
QUIET_HOURS_START=21
QUIET_HOURS_END=8
DEFAULT_TIMEZONE=America/New_York
PII_RETENTION_DAYS=30
AUDIT_RETENTION_YEARS=7
TRANSCRIPT_RETENTION_YEARS=2
AI_LEGAL_THREAT_ESCALATION_ENABLED=true
AI_COMPLAINT_ESCALATION_ENABLED=true

# ============================================================================
# WEBSOCKET & REALTIME
# ============================================================================
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_WINDOW=120000
WS_MAX_CONNECTIONS_PER_WORKSPACE=100
WS_MAX_PAYLOAD_SIZE=65536
WS_MAX_EVENTS_PER_SECOND=50
ENABLE_REALTIME_ANALYTICS=true

# ============================================================================
# QUEUE (BullMQ)
# ============================================================================
QUEUE_PREFIX=conversionops
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_MS=3000
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=1000
QUEUE_STALLED_INTERVAL=30000
QUEUE_MAX_STALLED_COUNT=2
MAX_PENDING_AI_JOBS=1000
MAX_PENDING_WEBHOOK_JOBS=5000
WORKER_CONCURRENCY=5

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT=1000

# ============================================================================
# AI SAFETY & GOVERNANCE
# ============================================================================
AI_CIRCUIT_BREAKER_ENABLED=true
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_MS=60000
AI_GLOBAL_EMERGENCY_DISABLE=false
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENT_GENERATIONS=10
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_MS=3000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1500
AI_ENABLE_HALLUCINATION_FILTER=true
AI_ENABLE_COMPLIANCE_FILTER=true
AI_ENABLE_RESPONSE_MODERATION=true
AI_ENABLE_PROMPT_LOGGING=true
AI_ENABLE_TOKEN_TRACKING=true
AI_ENABLE_LATENCY_TRACKING=true
AI_CONTEXT_COMPACTION_ENABLED=true
AI_MEMORY_SUMMARIZATION_THRESHOLD=20

# ============================================================================
# AI CONFIDENCE THRESHOLDS
# ============================================================================
AI_ESCALATION_CONFIDENCE_THRESHOLD=0.72
AI_BOOKING_CONFIDENCE_THRESHOLD=0.78
ENABLE_AI_REACTIVATION=true
ENABLE_AI_AUTONOMOUS_BOOKING=true
ENABLE_EXPERIMENTAL_ROUTING=false

# ============================================================================
# API TIMEOUTS
# ============================================================================
API_REQUEST_TIMEOUT_MS=20000
HEALTHCHECK_TIMEOUT_MS=5000
STARTUP_TIMEOUT_MS=60000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
ENABLE_STARTUP_PROBES=true
ENABLE_LIVENESS_PROBES=true

# ============================================================================
# OBSERVABILITY
# ============================================================================
ENABLE_TRACING=false
ENABLE_METRICS=false
ENABLE_STRUCTURED_LOGGING=true
LOG_CORRELATION_IDS=true
OTEL_SERVICE_NAME=conversionops-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================================================
# ANALYTICS (Next.js apps)
# ============================================================================
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_QUEUE_INSPECTOR=false
ENABLE_AI_PLAYGROUND=false
ENABLE_AUDIT_LOGS=true
ENABLE_WORKFLOW_TRACING=false
ENABLE_EVALS_IN_CI=false

# ============================================================================
# DEAD LEAD REACTIVATION
# ============================================================================
DORMANCY_THRESHOLD_DAYS=30
MAX_REACTIVATION_ATTEMPTS=3

# ============================================================================
# DEPLOYMENT
# ============================================================================
DISABLE_MOCKS=true
STRICT_ENV_VALIDATION=true
REQUIRE_SECRET_MANAGER_IN_PRODUCTION=false
