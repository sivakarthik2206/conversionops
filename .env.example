# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://conversionops:password@localhost:5432/conversionops
REDIS_URL=redis://localhost:6379

# ─── Azure OpenAI ───────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# ─── Twilio ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_PRICE_ID=
STRIPE_BROKERAGE_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ─── Resend ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@conversionops.in

# ─── Cal.com ────────────────────────────────────────
CALCOM_API_KEY=

# ─── CRM Integrations ───────────────────────────────
FOLLOW_UP_BOSS_API_KEY=

# ─── Auth ───────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=7d
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRY=15m

# ─── App URLs ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.conversionops.in
NEXT_PUBLIC_API_URL=https://api.conversionops.in
NEXT_PUBLIC_WS_URL=wss://api.conversionops.in
API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# ─── Observability ──────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ─── Feature Flags ──────────────────────────────────
ENABLE_AI_REACTIVATION=false
ENABLE_ADVANCED_ROUTING=false
ENABLE_EVALS_IN_CI=true

# ─── Internal ───────────────────────────────────────
NODE_ENV=development
PORT=3001
WORKER_CONCURRENCY=5
