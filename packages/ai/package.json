    "@conversionops/sdk-standards": "workspace:*",
    "@conversionops/types": "workspace:*",
    "xstate": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
