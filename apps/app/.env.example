# ============================================================================
# ConversionOps — apps/app (dashboard) — Environment Variable Reference
# Copy to .env.local and fill in real values. Never commit .env.local.
# All NEXT_PUBLIC_* values are baked into the client bundle at build time.
# ============================================================================

# Base URL of the NestJS API. MUST include the /v1 prefix.
NEXT_PUBLIC_API_URL=https://api.conversionops.in/v1

# WebSocket gateway URL for realtime updates (conversations, queue, notifications).
NEXT_PUBLIC_WS_URL=wss://api.conversionops.in

# Used for Sentry environment tagging and feature gating.
NEXT_PUBLIC_ENVIRONMENT=production

# Client-side error tracking. Leave empty to disable Sentry in the browser.
NEXT_PUBLIC_SENTRY_DSN=

# Paddle billing checkout — public client-side token (safe to expose).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Build-time only — enables Sentry source map upload during `next build`.
# Leave unset for local development; required in CI/CD for readable stack traces.
SENTRY_AUTH_TOKEN=
